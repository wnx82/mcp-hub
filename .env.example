# =============================================================================
# MCP Hub — example environment
#
#   cp .env.example .env && chmod 600 .env
#
# Deployed as a systemd unit, this file is typically installed to
# /etc/default/mcp-hub (root:root 0600) and pulled in via EnvironmentFile=.
#
# NOTHING here is committed: .env is git-ignored. Only this example is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Where the hub keeps hosts.yaml and state.db.
MCP_HUB_HOME=/opt/mcp-hub

# Bind address. Default 127.0.0.1 — expose it only behind a reverse proxy or a
# tunnel (Cloudflare Tunnel, Tailscale, WireGuard). Setting 0.0.0.0 publishes
# remote shell execution on your LAN: do it deliberately, not by default.
MCP_BIND_ADDR=127.0.0.1
MCP_PORT=8000

# Public hostname the hub is reached on (documentation / self-reported URLs).
#MCP_PUBLIC_HOST=mcp.example.com

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Unguessable path segment for the streamable-http endpoint. Obscurity only —
# it is not authentication. Generate: openssl rand -hex 16
MCP_SECRET_PATH=changeme-openssl-rand-hex-16

# Bearer token required on every request. THIS is the actual authentication.
# Leave empty to disable (not recommended). Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional root-owned JSON file defining multiple bearer tokens with access
# levels and tool/host/tag restrictions. MCP_AUTH_TOKEN remains an admin token
# when both settings are present.
#MCP_AUTH_PROFILES_FILE=/etc/mcp-hub/auth-profiles.json

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------
# Global kill-switch: when true, every mutating tool (exec, write, power,
# destroy, service control, DNS changes...) refuses to run. Strongly
# recommended for a first run, and for any hub reachable from the internet.
MCP_READ_ONLY=true

# Confirmation policy for mutating tools: off, sensitive (default), or all.
# Plans are one-time, profile-bound, and expire after 30-900 seconds.
MCP_CONFIRMATION_MODE=sensitive
MCP_CONFIRMATION_TTL_SECONDS=300

# Resource guards. Limits are per process; token quotas use the authenticated
# profile identity, while concurrency and circuit breakers are per target host.
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_MAX_ARGUMENT_BYTES=200000
MCP_MAX_CONCURRENT_PER_HOST=4
MCP_CIRCUIT_FAILURES=3
MCP_CIRCUIT_RESET_SECONDS=60
MCP_MUTATION_COOLDOWN_SECONDS=1

# Reversible mutation snapshots are retained in state.db (mode 0600).
MCP_SNAPSHOT_MAX_BYTES=65536
MCP_SNAPSHOT_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# SSH access to the fleet
# -----------------------------------------------------------------------------
MCP_SSH_KEY=~/.ssh/id_ed25519
MCP_SSH_CONTROL_DIR=~/.ssh/mcp-hub-control

# -----------------------------------------------------------------------------
# Secrets provider: "env" (default, read from this file) or "vaultwarden"
# -----------------------------------------------------------------------------
MCP_SECRETS_PROVIDER=env

# --- vaultwarden provider only (Bitwarden CLI `bw serve` daemon) -------------
#BW_SERVE_URL=http://127.0.0.1:8090
# Vault item UUIDs holding the credentials for each integration.
#DSM_CRED_ITEM_UUID=
#NOTION_TOKEN_ITEM_UUID=

# =============================================================================
# Optional integrations — each is disabled unless its *_ENABLED flag is true.
# =============================================================================

# --- Cloudflare (tunnels, ingress, DNS) --------------------------------------
CLOUDFLARE_ENABLED=false
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_ZONE_ID=

# --- n8n ----------------------------------------------------------------------
N8N_ENABLED=false
#N8N_API_URL=http://n8n.example.lan:5678
#N8N_API_KEY=
# Per-integration override; MCP_READ_ONLY=true wins over this.
#N8N_READ_ONLY=true

# --- Synology DSM -------------------------------------------------------------
DSM_ENABLED=false
#DSM_WEBAPI_BASE=http://nas.example.lan:5000
# With MCP_SECRETS_PROVIDER=env:
#DSM_USER=
#DSM_PASSWORD=

# --- Notion -------------------------------------------------------------------
NOTION_ENABLED=false
# With MCP_SECRETS_PROVIDER=env:
#NOTION_TOKEN=

# --- LM Studio ----------------------------------------------------------------
LMSTUDIO_ENABLED=false
# Name of an entry in hosts.yaml, not an IP.
#LMSTUDIO_HOST=workstation
#LMSTUDIO_PORT=1234

# --- Wake-on-LAN ---------------------------------------------------------------
WOL_ENABLED=false
#WOL_BROADCAST=192.0.2.255
